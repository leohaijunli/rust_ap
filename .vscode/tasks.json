{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup Windows tools",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/setup_windows.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Build firmware (.px4)",
      "group": { "kind": "build", "isDefault": true },
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/build_firmware.ps1"
      ],
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Upload firmware (USB)",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/upload_firmware.ps1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
